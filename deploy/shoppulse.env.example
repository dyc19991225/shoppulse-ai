# ShopPulse AI production environment (zz).
# Copy to /opt/shoppulse-ai/shoppulse.env, then: chmod 600 /opt/shoppulse-ai/shoppulse.env
# NEVER commit this file or paste its contents into logs / chat.
#
# NODE_ENV, PORT and HOSTNAME are set by shoppulse-ai.service and should not
# be repeated here.

# SQLite database. install.sh points this at the writable data directory.
SHOPPULSE_DB_PATH=/var/lib/shoppulse-ai/shoppulse.db

# OpenAI-compatible LLM gateway (WorkBuddy). Keep the key server-side only.
SHOPPULSE_LLM_BASE_URL=http://192.74.249.13:8788/v1
SHOPPULSE_LLM_MODEL=deepseek-v4.1-flash
SHOPPULSE_LLM_API_KEY=
SHOPPULSE_LLM_TIMEOUT_MS=60000

# Production must use the real model. With this set and no key, /api/health
# returns 503 and the app never silently falls back to mock mode.
SHOPPULSE_REQUIRE_LLM=1

# The service is only reachable through Caddy, which appends the real client
# address to X-Forwarded-For. Trust the right-most hop for rate limiting.
SHOPPULSE_TRUST_PROXY=1
# Canonical public origin used in admin embed snippets. Set this to the real
# HTTPS origin; otherwise snippets fall back to the local request URL.
SHOPPULSE_PUBLIC_BASE_URL=https://shop-ai.dycxy.shop

# Admin login. Generate the hash with:
#   node /opt/shoppulse-ai/current/deploy/hash-password.mjs --stdin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# HMAC key for session cookies. install.sh generates a random 32-byte hex value
# on first install; replace only if rotating (this logs everyone out).
SESSION_SECRET=
