# ---- Database ----
# SQLite file path (default ./data/shoppulse.db)
SHOPPULSE_DB_PATH=./data/shoppulse.db

# ---- LLM (OpenAI-compatible gateway) ----
SHOPPULSE_LLM_BASE_URL=http://192.74.249.13:8788/v1
SHOPPULSE_LLM_MODEL=deepseek-v4.1-flash
# Never commit a real key; leave empty locally to use mock mode.
SHOPPULSE_LLM_API_KEY=
# Request timeout in milliseconds (default 60000)
SHOPPULSE_LLM_TIMEOUT_MS=60000
# Set to 1 in production: missing API key makes /api/health report an error
# and the app never falls back to mock mode.
SHOPPULSE_REQUIRE_LLM=0

# ---- Admin auth ----
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- 'your-password'
# (scrypt, format salt:hash in hex)
ADMIN_PASSWORD_HASH=
# Development-only plaintext fallback; ignored when NODE_ENV=production.
ADMIN_PASSWORD=
# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
